# PulseTrack Terraform variables — copy this file to terraform.tfvars and fill in.
# NEVER commit terraform.tfvars (it's in .gitignore).

# Required: AWS region. EMR pricing and AZ availability vary by region.
aws_region = "us-east-1"

# Required: deployment environment. Use "dev" for daily work; "prod" is template-only.
environment = "dev"

# Required: email address that receives the budget alert (80% of monthly cap) and ops SNS notifications.
alert_email = "you@example.com"

# Required: name of an EXISTING EC2 key pair in the chosen region. Used for SSH to the EMR master.
# Create one in the AWS console (EC2 → Key Pairs) before running `terraform apply`.
key_pair_name = "pulsetrack-emr"

# Optional: VPC layout. Defaults give a /16 with 2 public /24 subnets across 2 AZs.
# vpc_cidr            = "10.42.0.0/16"
# public_subnet_cidrs = ["10.42.1.0/24", "10.42.2.0/24"]

# Optional: EMR sizing. Defaults are tuned for the dev cost envelope (~$0.30/hr running).
# emr_release_label        = "emr-7.2.0"
# emr_master_instance_type = "m5.xlarge"
# emr_core_instance_type   = "m5.xlarge"
# emr_core_instance_count  = 2
# emr_core_spot_bid_price  = "0.08"
# emr_ebs_volume_size_gb   = 64
# emr_idle_timeout_seconds = 7200    # 2h auto-terminate when idle

# Optional: monthly AWS budget cap (USD). Alert fires at 80%.
# budget_limit_usd = "40"
