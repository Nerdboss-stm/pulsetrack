      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsetrack-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (layer, source) (rate(pt_records_processed_total[1m]))",
          "legendFormat": "{{layer}} / {{source}}",
