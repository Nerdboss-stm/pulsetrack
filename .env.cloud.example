# PulseTrack — example environment file for cloud (EMR + MSK + Snowflake) usage
#
# Post-Secrets-Manager workflow:
# ------------------------------
# This file is the TIER-3 fallback only. Production credentials live in
# AWS Secrets Manager (see infrastructure/modules/secrets/). Local dev
# can still use this file for convenience, but the values should be
# placeholders or already-rotated dev tokens — NOT real production secrets.
#
# Bootstrap once: copy this to ``.env``, fill in your dev values, then
#   $ python scripts/bootstrap_secrets.py
# uploads them to AWS Secrets Manager. After that, the producers on EMR
# read from Secrets Manager via ``pt_secrets.get_secret`` — no .env on
# EMR master is needed.
#
# NEVER commit a populated .env. The .gitignore covers it, but the
# pre-commit gitleaks hook is the belt-and-suspenders.

# ── Environment ─────────────────────────────────────────────────────────
PT_AWS_ENV=dev                          # dev / staging / prod
PT_ENVIRONMENT=cloud                    # local / cloud (chooses Spark config path)
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=pulsetrack

# ── Infrastructure (auto-populated from terraform output) ───────────────
# After `cd infrastructure && terraform apply`, run:
#   bash scripts/generate_cloud_env.sh
# to fill these in. Don't hand-type them — they're long.
PT_LAKEHOUSE_BUCKET=                    # e.g. pulsetrack-dev-lakehouse-abc12345
PT_LAKEHOUSE_BASE=                      # e.g. s3://pulsetrack-dev-lakehouse-abc12345
PT_EMR_CLUSTER_ID=                      # j-XXXXXXXXX
PT_KAFKA_BOOTSTRAP=                     # boot-XXXX.c3.kafka-serverless.us-east-1.amazonaws.com:9098
PT_KAFKA_SECURITY_PROTOCOL=SASL_SSL
PT_SCHEMA_REGISTRY_URL=                 # e.g. http://schema-registry.internal:8081

# ── Iceberg / Glue catalog ──────────────────────────────────────────────
PT_ICEBERG_CATALOG_TYPE=glue
PT_ICEBERG_CATALOG=glue_iceberg

# ── WHOOP (dev account) ─────────────────────────────────────────────────
# Source-of-truth in production: pulsetrack/<env>/whoop in Secrets Manager
PT_WHOOP_CLIENT_ID=                     # your developer.whoop.com client_id
PT_WHOOP_CLIENT_SECRET=                 # your developer.whoop.com client_secret (ROTATE every 90 days)
PT_WHOOP_REDIRECT_URI=http://localhost:8765/callback
PT_WHOOP_ACCOUNT_ID=                    # account ID from your WHOOP profile
PT_WHOOP_USER_EMAIL=                    # used by vw_whoop_my_health filter

# Tokens — managed by scripts/whoop_auth_bootstrap.sh, written to
# Secrets Manager (pulsetrack/<env>/whoop-tokens). The .env path
# is the fallback only.
# PT_WHOOP_TOKEN_PATH=~/.whoop_tokens.json

# ── Anthropic Claude ───────────────────────────────────────────────────
# Source-of-truth: pulsetrack/<env>/anthropic in Secrets Manager
ANTHROPIC_API_KEY=                      # sk-ant-...
PT_ANTHROPIC_API_KEY=                   # mirror, so config.py picks it up
PT_AI_MODEL=claude-sonnet-4-5
PT_AI_MAX_TOKENS=4096

# ── Snowflake (consumer-side BI + ML) ──────────────────────────────────
# Source-of-truth: pulsetrack/<env>/snowflake in Secrets Manager
PT_SNOWFLAKE_ACCOUNT=                   # e.g. abc12345.us-east-1
PT_SNOWFLAKE_USER=PULSETRACK_LOADER     # from snowflake/setup/01_create_infrastructure.sql
PT_SNOWFLAKE_PASSWORD=                  # or use private-key auth (see docs/secret_rotation.md)
PT_SNOWFLAKE_ROLE=PULSETRACK_RW
PT_SNOWFLAKE_WAREHOUSE=PULSETRACK_WH
PT_SNOWFLAKE_DATABASE=PULSETRACK
PT_SNOWFLAKE_SCHEMA=ANALYTICS

# ── Observability ──────────────────────────────────────────────────────
# Source-of-truth: pulsetrack/<env>/slack + pulsetrack/<env>/pagerduty
PT_SLACK_WEBHOOK_URL=                   # https://hooks.slack.com/services/...
PT_PAGERDUTY_ROUTING_KEY=               # leave blank for mock-only path
PT_SNS_ALERT_TOPIC_ARN=                 # arn:aws:sns:us-east-1:...:pulsetrack-dev-alerts
PT_OBSERVABILITY_TABLE=glue_iceberg.pulsetrack_gold_dev.monitor_runs

# ── Producer tunables ──────────────────────────────────────────────────
PT_WEARABLE_EVENTS_PER_SECOND=10
PT_PHARMACY_CHANGES_PER_MINUTE=5
PT_USER_COUNT=100
PT_WHOOP_POLL_INTERVAL_SECONDS=900
PT_WHOOP_BACKFILL_DAYS=30

# ── Streaming tunables ─────────────────────────────────────────────────
PT_TRIGGER_INTERVAL="30 seconds"
PT_MAX_OFFSETS_PER_TRIGGER=10000
PT_WATERMARK_DELAY="10 minutes"
PT_LATE_ARRIVAL_THRESHOLD_SECONDS=7200
PT_SHUFFLE_PARTITIONS=4

# ── Prefect Cloud (optional) ───────────────────────────────────────────
# PREFECT_API_KEY=
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/.../workspaces/...

# ── Grafana (optional, for scale-test screenshot capture) ──────────────
# PT_GRAFANA_URL=https://your-grafana.example.com
# PT_GRAFANA_API_KEY=

# ── dbt ────────────────────────────────────────────────────────────────
PT_DBT_PROJECT_DIR=/Users/you/pulsetrack-cm/dbt_project
PT_DBT_TARGET=dev                       # dev (duckdb) / snowflake / prod

# ── HAPI FHIR (no auth needed for public test server) ──────────────────
PT_HAPI_FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# ── OpenFDA (no auth needed; rate-limited 240 req/min anonymous) ───────
PT_OPENFDA_BASE_URL=https://api.fda.gov
